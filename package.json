{
  "name": "aether-simulator",
  "version": "0.4.0",
  "description": "Deterministic synthetic-world research simulator",
  "type": "module",
  "private": false,
  "bin": {
    "aether": "./src/cli.mjs"
  },
  "exports": {
    ".": "./src/index.mjs",
    "./evidence-bridge": "./packages/evidence-bridge/src/index.mjs"
  },
  "files": [
    "docs/",
    "examples/",
    "fixtures/",
    "packages/evidence-bridge/",
    "scenarios/",
    "schemas/",
    "src/"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "cli": "node src/cli.mjs",
    "demo": "node scripts/demo.mjs",
    "demo:enterprise": "node scripts/demo-enterprise.mjs",
    "demo:ecosystem": "node scripts/demo-ecosystem.mjs",
    "test": "node --test",
    "test:replay": "node --test tests/determinism.test.mjs",
    "test:bridge": "node --test tests/evidence-bridge.test.mjs",
    "test:enterprise": "node --test tests/enterprise-depth.test.mjs",
    "test:ecosystem": "node --test tests/ecosystem-depth.test.mjs",
    "fixtures:enterprise": "node scripts/generate-enterprise-fixtures.mjs",
    "fixtures:ecosystem": "node scripts/generate-ecosystem-fixtures.mjs",
    "benchmark:enterprise": "node scripts/benchmark-enterprise.mjs",
    "benchmark:ecosystem": "node scripts/benchmark-ecosystem.mjs",
    "validate:fixtures": "node scripts/validate-fixtures.mjs",
    "validate:schemas": "node scripts/validate-schemas.mjs",
    "verify:fixtures:drift": "node scripts/verify-fixture-drift.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "verify:workflows": "node scripts/verify-workflows.mjs",
    "verify:public": "node scripts/verify-public-tree.mjs",
    "scan:sensitive": "node scripts/scan-sensitive-content.mjs",
    "verify": "npm run build && npm test && npm run validate:schemas && npm run validate:fixtures && npm run verify:workflows && npm run verify:public && npm run scan:sensitive",
    "verify:ci": "npm run verify && npm run verify:fixtures:drift && npm run verify:package && npm audit --omit=dev --audit-level=high"
  },
  "keywords": [
    "simulation",
    "synthetic-data",
    "deterministic",
    "research"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "ajv": "8.20.0"
  }
}
