{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/aether-enterprise-simulator/schemas/aether-world.v0.1.schema.json",
  "title": "Aether deterministic synthetic world",
  "type": "object",
  "required": [
    "contract_version",
    "research_status",
    "seed",
    "world_ref",
    "simulation_tick",
    "provenance",
    "company",
    "systems",
    "people",
    "workflows",
    "pii_lineage"
  ],
  "properties": {
    "contract_version": { "const": "aether-world.v0.1" },
    "research_status": { "const": "experimental" },
    "seed": { "type": "integer", "minimum": 0 },
    "world_ref": { "type": "string", "minLength": 1 },
    "simulation_tick": { "type": "integer", "minimum": 0 },
    "provenance": {
      "type": "object",
      "required": ["origin", "tier", "external_credentials_used"],
      "properties": {
        "origin": { "const": "deterministic-generator" },
        "tier": { "const": "synthetic" },
        "external_credentials_used": { "const": false }
      },
      "additionalProperties": false
    },
    "company": {
      "type": "object",
      "required": ["id", "name", "fictional", "operating_model"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "fictional": { "const": true },
        "operating_model": { "type": "string" }
      },
      "additionalProperties": false
    },
    "systems": { "type": "array", "minItems": 2 },
    "people": { "type": "array", "minItems": 2 },
    "workflows": { "type": "array", "minItems": 1 },
    "pii_lineage": {
      "type": "object",
      "required": ["seed_ref", "citizens", "records"],
      "properties": {
        "seed_ref": { "type": "string" },
        "citizens": { "type": "array" },
        "records": { "type": "array", "minItems": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
